{
  "name": "@tractorbeam/oxlint-config",
  "version": "0.3.0",
  "description": "Shared Oxlint configuration for Tractorbeam projects",
  "keywords": [
    "config",
    "linter",
    "oxlint",
    "tractorbeam",
    "tractorbeamai"
  ],
  "homepage": "https://github.com/tractorbeamai/reusables/tree/main/packages/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/tractorbeamai/reusables/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tractorbeamai/reusables.git",
    "directory": "packages/oxlint-config"
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./anti-slop": {
      "default": "./dist/anti-slop.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@tractorbeam/typescript-config": "workspace:*",
    "oxlint": "catalog:",
    "oxlint-plugin-anti-slop": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
