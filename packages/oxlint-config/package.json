{
  "name": "@tractorbeam/oxlint-config",
  "version": "0.1.0",
  "description": "Shared Oxlint configuration for Tractorbeam projects",
  "keywords": [
    "config",
    "linter",
    "oxlint",
    "tractorbeam",
    "tractorbeamai"
  ],
  "homepage": "https://github.com/tractorbeamai/reusables/tree/main/packages/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/tractorbeamai/reusables/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tractorbeamai/reusables.git",
    "directory": "packages/oxlint-config"
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./anti-slop": {
      "default": "./dist/anti-slop.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint:types": "tsc --noEmit",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@tractorbeam/typescript-config": "workspace:*",
    "oxlint": "1.78.0",
    "oxlint-plugin-anti-slop": "github:dmmulroy/anti-slop#b5d2288db1f00469a1d5f2e3b0e265e5a5676fd0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vite-plus": "0.2.4"
  }
}
