{
  "name": "@tractorbeam/typescript-config",
  "version": "0.4.0",
  "description": "Shared tsconfig presets for Tractorbeam projects",
  "keywords": [
    "cloudflare-workers",
    "effect",
    "nextjs",
    "tanstack",
    "tractorbeam",
    "tractorbeamai",
    "tsconfig",
    "tsconfig-bases",
    "typescript",
    "vitest"
  ],
  "homepage": "https://github.com/tractorbeamai/reusables/tree/main/packages/typescript-config#readme",
  "bugs": {
    "url": "https://github.com/tractorbeamai/reusables/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tractorbeamai/reusables.git",
    "directory": "packages/typescript-config"
  },
  "files": [
    "*.json",
    "*.ts",
    "package.json",
    "README.md"
  ],
