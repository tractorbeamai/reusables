    "./cloudflare-workers": "./cloudflare-workers.json",
    "./node": "./node.json",
    "./node22": "./node22.json",
    "./next": "./next.json",
    "./tanstack-start": "./tanstack-start.json",
    "./effect": "./effect.json",
    "./vitest": "./vitest.json",
    "./strictest": "./strictest.json",
    "./presets": "./presets.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
