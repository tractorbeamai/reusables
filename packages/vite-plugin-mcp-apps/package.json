{
  "name": "@tractorbeam/vite-plugin-mcp-apps",
  "version": "0.1.0",
  "description": "Build filesystem-based MCP Apps as self-contained HTML files with Vite",
  "keywords": [
    "mcp",
    "mcp-apps",
    "model-context-protocol",
    "plugin",
    "tractorbeam",
    "vite"
  ],
  "homepage": "https://github.com/tractorbeamai/reusables/tree/main/packages/vite-plugin-mcp-apps#readme",
  "bugs": {
    "url": "https://github.com/tractorbeamai/reusables/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tractorbeamai/reusables.git",
    "directory": "packages/vite-plugin-mcp-apps"
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "parse5": "catalog:",
    "postcss": "catalog:",
    "postcss-value-parser": "catalog:",
    "tinyglobby": "catalog:",
    "vite-plugin-singlefile": "catalog:"
  },
  "devDependencies": {
    "@tractorbeam/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
