{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>tractorbeamai/.github:renovate-config"],
  packageRules: [
    {
      description: "Stay on Node 24 type definitions to match the supported Node runtime",
      matchPackageNames: ["@types/node"],
      allowedVersions: "<25",
    },
    {
      description: "Stay on TypeScript 6 until a TypeScript 7 migration is planned",
      matchPackageNames: ["typescript"],
      allowedVersions: "<7",
    },
  ],
  postUpgradeTasks: {
    commands: [
      "npx --yes --ignore-scripts --package corepack@0.36.0 corepack pnpm install --lockfile-only --ignore-scripts --no-frozen-lockfile",
    ],
    fileFilters: ["pnpm-lock.yaml"],
    executionMode: "branch",
  },
}
